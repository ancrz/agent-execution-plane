#!/bin/sh
# sh/python polyglot: sh runs the next line (picks the project venv, falls back to system python3);
# Python parses that same line as a no-op triple-quoted string.
''''true; d=$(cd "$(dirname "$0")/.." && pwd); for p in "$d/.venv/bin/python" "$HOME/.local/share/agent-os/venv/bin/python"; do [ -x "$p" ] && exec "$p" "$0" "$@"; done; exec python3 "$0" "$@" # '''
"""
aep-ctl — Unified System Control Plane (SPEC-OM-1)

Punto de entrada CLI determinista para que un agente de IA controle el sistema sin
"adivinar" rutas de /etc ni flags. Garantías:
  1. Autodocumentación: `--schema` devuelve el contrato JSON de cada dominio.
  2. Determinismo: toda salida es JSON (sin ANSI, sin paginadores).
  3. No-interactividad: si falta un parámetro, sale con exit 1 y un JSON de remediación.

Sin dependencias externas (stdlib). Lecturas sin sudo; las mutaciones usan el scope
de usuario de systemd (`systemctl --user`) para no requerir privilegios.
"""

import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Any

PROJECT_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

from engine.privilege import (  # noqa: E402, I001
    CHMOD_DEGRADATION_MATRIX,
    CONTROL_PLANE_SCHEMA as SCHEMA,
    capability_tier,
    get_effective_chmod_tier,
    privilege_prefix,
)


def _sudo_prefix() -> list[str] | None:
    """Unificado con engine.privilege: [] si root; ['sudo','-n'] si escala sin password; None si DIMINISHED."""
    return privilege_prefix()


def _tier() -> str:
    return capability_tier()


def _chmod_tier() -> str:
    return str(get_effective_chmod_tier().get("tier", "6rw-"))


def emit(obj: Any, code: int = 0) -> None:
    print(json.dumps(obj, indent=2))
    sys.exit(code)


def fail(message: str, **extra: Any) -> None:
    emit({"status": "ERROR", "exit_code": 1, "message": message, **extra}, code=1)


def _run(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, check=False)


def _need(bin_name: str) -> str | None:
    return shutil.which(bin_name)


# ------------------------------------------------------------------ dominios
def domain_service(action: str, name: str | None) -> Any:
    if not _need("systemctl"):
        return {"status": "DEGRADED", "message": "systemctl no disponible en este host."}
    if action == "list":
        r = _run([
            "systemctl",
            "list-units",
            "--type=service",
            "--state=running",
            "--no-pager",
            "--plain",
            "--no-legend",
        ])
        services = []
        for ln in r.stdout.splitlines():
            parts = ln.split(None, 4)
            if len(parts) >= 4:
                services.append({
                    "unit": parts[0],
                    "load": parts[1],
                    "active": parts[2],
                    "sub": parts[3],
                    "description": parts[4].strip() if len(parts) > 4 else "",
                })
        return {"status": "OK", "capability_tier": _tier(), "count": len(services), "services": services}
    if not name:
        fail("Falta <name> del servicio.", usage="aep-ctl service <action> <name> --json")
    if action == "status":
        # Lectura de scope de sistema (servicios reales: redis, nginx...). No requiere sudo.
        r = _run(["systemctl", "show", name,
                  "--property=ActiveState,SubState,LoadState,MainPID,UnitFileState"])
        props = dict(
            line.split("=", 1) for line in r.stdout.splitlines() if "=" in line
        )
        if props.get("LoadState") == "not-found":
            # ONT-48/G13: una unidad inexistente no es un servicio sano.
            return {
                "status": "NOT_FOUND",
                "severity": "WARN",
                "service": name,
                "capability_tier": _tier(),
                "properties": props,
                "next_action": f'aep_ctl(domain="package", action="check", name="{name}")',
            }
        return {"status": "OK", "service": name, "capability_tier": _tier(), "properties": props}

    # Mutaciones (start/stop/restart): nivel FULL -> systemctl de sistema vía escalada;
    # DIMINISHED -> intenta scope de usuario (servicios --user) en 6rw-, o degrada a fail-soft/SIMULATED en 5r-x y 4r--.
    chmod_tier = _chmod_tier()
    if chmod_tier in ("4r--", "5r-x"):
        return {
            "status": "SIMULATED" if chmod_tier == "4r--" else "DEGRADED",
            "service": name,
            "action": action,
            "capability_tier": "DIMINISHED",
            "chmod_tier": chmod_tier,
            "scope": "read-only",
            "simulated": True,
            "message": f"Mutación de servicios simulada / degradada bajo nivel {chmod_tier} (solo-lectura/auditor).",
        }

    prefix = _sudo_prefix()
    if prefix is None:
        r = _run(["systemctl", "--user", action, name])
        return {
            "status": "OK" if r.returncode == 0 else "DIMINISHED",
            "service": name, "action": action, "capability_tier": "DIMINISHED",
            "chmod_tier": chmod_tier,
            "scope": "user", "exit_code": r.returncode,
            "stderr": r.stderr.strip() or None,
            "note": "Sin privilegio para servicios de sistema; limitado a scope de usuario.",
        }
    r = _run(prefix + ["systemctl", action, name])
    return {
        "status": "OK" if r.returncode == 0 else "FAILED",
        "service": name, "action": action, "capability_tier": "FULL",
        "chmod_tier": chmod_tier,
        "scope": "system", "exit_code": r.returncode,
        "stderr": r.stderr.strip() or None,
    }


def domain_network(action: str, name: str | None = None, ports_arg: str | None = None) -> Any:
    from engine import net_telemetry

    if action == "probe":
        import asyncio
        target = name.strip() if name and name.strip() else "127.0.0.1"
        ports = None
        if ports_arg and ports_arg.strip():
            parsed_ports = []
            for raw_item in ports_arg.strip().split(","):
                item = raw_item.strip()
                if not item:
                    continue
                if "-" in item:
                    try:
                        p_start, p_end = map(int, item.split("-", 1))
                        parsed_ports.extend(range(p_start, p_end + 1))
                    except ValueError:
                        pass
                else:
                    try:
                        parsed_ports.append(int(item))
                    except ValueError:
                        pass
            if parsed_ports:
                ports = parsed_ports
        return asyncio.run(net_telemetry.probe_tcp_ports(target, ports))

    if action == "interfaces":
        devs = net_telemetry.parse_proc_net_dev()
        if devs:
            return {"status": "OK", "count": len(devs), "interfaces": devs}
        if not _need("ip"):
            return {"status": "DEGRADED", "message": "ni /proc/net/dev ni ip disponible."}
        r = _run(["ip", "-j", "addr"])
        try:
            return {"status": "OK", "interfaces": json.loads(r.stdout or "[]")}
        except Exception:
            return {"status": "OK", "interfaces_raw": r.stdout.strip()}

    if action == "arp":
        arps = net_telemetry.parse_proc_net_arp()
        return {"status": "OK", "count": len(arps), "arp": arps}

    if action == "listeners":
        socks = net_telemetry.parse_proc_net_sockets("tcp", resolve_pids=True)
        if socks:
            return {"status": "OK", "count": len(socks), "listeners": socks}
        if not _need("ss"):
            return {"status": "DEGRADED", "message": "ss no disponible."}
        prefix = _sudo_prefix() or []
        r = _run(prefix + ["ss", "-tulnpH"])
        listeners = []
        for ln in r.stdout.splitlines():
            parts = ln.split()
            if len(parts) >= 5:
                pid = None
                proc_name = None
                fd = None
                m = re.search(r'users:\(\("([^"]+)",pid=(\d+)(?:,fd=(\d+))?', ln)
                if m:
                    proc_name = m.group(1)
                    try:
                        pid = int(m.group(2))
                    except (ValueError, TypeError):
                        pid = None
                    if m.group(3):
                        try:
                            fd = int(m.group(3))
                        except (ValueError, TypeError):
                            fd = None
                entry = {
                    "proto": parts[0],
                    "state": parts[1],
                    "local": parts[4],
                    "pid": pid,
                    "process": proc_name,
                }
                if fd is not None:
                    entry["fd"] = fd
                listeners.append(entry)
        return {"status": "OK", "count": len(listeners), "listeners": listeners}

    if action == "routes":
        if not _need("ip"):
            return {"status": "DEGRADED", "message": "ip no disponible."}
        r = _run(["ip", "-j", "route"])
        try:
            return {"status": "OK", "routes": json.loads(r.stdout or "[]")}
        except Exception:
            return {"status": "OK", "routes_raw": r.stdout.strip()}

    if action == "inspect":
        if not _need("ip"):
            return {"status": "DEGRADED", "message": "ip no disponible."}
        r = _run(["ip", "-j", "addr"])
        try:
            return {"status": "OK", "interfaces": json.loads(r.stdout or "[]")}
        except Exception:
            return {"status": "OK", "interfaces_raw": r.stdout.strip()}

    fail(f"Acción de network desconocida: {action}", valid=SCHEMA["network"]["actions"])


def domain_storage(action: str) -> Any:
    if action == "usage":
        r = _run(["df", "-B1", "--output=source,target,size,used,avail,pcent"])
        rows = []
        for ln in r.stdout.splitlines()[1:]:
            p = ln.split()
            if len(p) >= 6:
                rows.append({"source": p[0], "mount": p[1], "size": int(p[2]),
                             "used": int(p[3]), "avail": int(p[4]), "use_pct": p[5]})
        return {"status": "OK", "filesystems": rows}
    if action == "mounts":
        if _need("findmnt"):
            r = _run(["findmnt", "-J"])
            try:
                return {"status": "OK", **json.loads(r.stdout or "{}")}
            except Exception:  # noqa: S110
                pass
        return {"status": "DEGRADED", "message": "findmnt no disponible."}
    if action == "disks":
        if _need("lsblk"):
            r = _run(["lsblk", "-J", "-o", "NAME,SIZE,TYPE,MOUNTPOINT"])
            try:
                return {"status": "OK", **json.loads(r.stdout or "{}")}
            except Exception:  # noqa: S110
                pass
        return {"status": "DEGRADED", "message": "lsblk no disponible."}
    fail(f"Acción de storage desconocida: {action}", valid=SCHEMA["storage"]["actions"])


def domain_package(action: str, name: str | None) -> Any:
    if not _need("dpkg-query"):
        return {"status": "DEGRADED", "message": "dpkg-query no disponible (¿no es Debian/Ubuntu?)."}
    if action in ("installed", "list"):
        r = _run(["dpkg-query", "-W", "-f=${Package}\t${Version}\t${Status}\n"])
        pkgs = []
        for ln in r.stdout.splitlines():
            parts = ln.split("\t")
            if len(parts) == 3 and parts[2].startswith("install ok"):
                pkgs.append({"name": parts[0], "version": parts[1]})
        return {"status": "OK", "count": len(pkgs), "packages": pkgs[:500]}
    if not name:
        fail("Falta <name> del paquete.", usage=f"aep-ctl package {action} <name> --json")
    if action == "check":
        r = _run(["dpkg-query", "-W", "-f=${Status}", name])
        installed = r.returncode == 0 and "install ok installed" in r.stdout
        return {"status": "OK", "package": name, "installed": installed}
    if action == "info":
        r = _run(["dpkg-query", "-W", "-f=${Package}\t${Version}\t${Architecture}\t${Installed-Size}", name])
        if r.returncode != 0:
            return {"status": "OK", "package": name, "installed": False}
        p = r.stdout.split("\t")
        return {"status": "OK", "package": p[0], "version": p[1],
                "arch": p[2] if len(p) > 2 else None}
    fail(f"Acción de package desconocida: {action}", valid=SCHEMA["package"]["actions"])


def domain_security(action: str, name: str | None) -> Any:
    from engine.landlock import get_landlock_status

    if action in ("landlock_status", "status"):
        return get_landlock_status()
    if action == "firewall_status":
        if _need("ufw"):
            r = _run(["ufw", "status"])
            return {
                "status": "OK",
                "backend": "ufw",
                "active": "active" in r.stdout.lower(),
                "stdout": r.stdout.strip()[:300],
            }
        if _need("nft"):
            return {
                "status": "OK",
                "backend": "nftables",
                "active": True,
            }
        return {"status": "OK", "backend": "none", "active": False, "message": "Neither ufw nor nftables utility found"}
    if action == "nftables_inspect":
        if not _need("nft"):
            return {"status": "DEGRADED", "message": "nft binary not found"}
        prefix = _sudo_prefix() or []
        r = _run(prefix + ["nft", "list", "ruleset"])
        if r.returncode == 0:
            lines = [ln.strip() for ln in r.stdout.splitlines() if ln.strip()]
            return {"status": "OK", "rules_count": len(lines), "ruleset": lines[:50]}
        return {"status": "DEGRADED", "message": "nftables unprivileged or not configured", "stderr": r.stderr.strip()[:200]}
    if action == "threat_mitigate":
        if not name:
            fail("Falta <target_ip> para threat_mitigate", usage="aep-ctl security threat_mitigate <ip> --json")
        from engine.net_telemetry import enforce_netfilter_mitigation
        chmod_tier = _chmod_tier()
        # En tiers 6rw-, 5r-x y 4r-- emite SIMULATED; en 7rwx aplica netfilter real
        return enforce_netfilter_mitigation(name, rule_action="drop", simulate=(chmod_tier != "7rwx"))
    fail(f"Acción de security desconocida: {action}", valid=SCHEMA["security"]["actions"])


def domain_backup(action: str, name: str | None) -> Any:
    chmod_tier = _chmod_tier()
    if action in (
        "backup", "restore", "golden", "restore_golden", "workspace_snapshot",
        "workspace_restore", "micro_snapshot", "restore_micro_snapshot", "clear_micro_snapshots",
    ):
        if chmod_tier in ("4r--", "5r-x"):
            return {
                "status": "DEGRADED",
                "action": action,
                "chmod_tier": chmod_tier,
                "scope": "read-only",
                "message": f"Mutaciones de backup deshabilitadas en nivel {chmod_tier}; degradado a verificación.",
            }

    if action in ("lkg_status", "lkg_diff", "lkg_restore"):
        from engine import lkg_ctl

        def _snap(_files: list[str]) -> Any:
            from engine.backup import create_workspace_snapshot

            return create_workspace_snapshot(path=PROJECT_ROOT)

        return lkg_ctl.lkg_ctl(
            action,
            name,
            repo_root=os.environ.get("AEP_REPO_ROOT") or PROJECT_ROOT,
            tier_octal=int(get_effective_chmod_tier()["octal"]),
            apply=os.environ.get("AEP_LKG_APPLY") == "1",
            snapshot_fn=_snap,
        )

    from engine.backup import (
        clear_micro_snapshots,
        create_backup,
        create_golden_snapshot,
        create_micro_snapshot,
        get_backup_status,
        get_quarantine_status,
        list_micro_snapshots,
        restore_backup,
        restore_golden_snapshot,
        restore_micro_snapshot,
        verify_and_auto_recover,
        verify_database_integrity,
    )

    if action == "backup":
        return create_backup()
    if action == "restore":
        slot = 1
        if name and name.strip():
            try:
                slot = int(name.strip())
            except ValueError:
                fail(f"Número de slot inválido: {name}", valid="1..5")
        return restore_backup(slot_number=slot)
    if action in ("status", "backup_status"):
        return get_backup_status()
    if action in ("auto_recover", "verify_and_auto_recover"):
        return verify_and_auto_recover()
    if action == "verify_integrity":
        target = Path(name.strip()) if name and name.strip() else None
        ok, reason, details = verify_database_integrity(target)
        return {"status": "OK" if ok else "INTEGRITY_FAILED", "valid": ok, "reason": reason, "details": details}
    if action == "micro_snapshot":
        snap_id = name.strip() if name and name.strip() else "default"
        return create_micro_snapshot(snapshot_id=snap_id)
    if action == "restore_micro_snapshot":
        snap_id = name.strip() if name and name.strip() else "default"
        return restore_micro_snapshot(snapshot_id=snap_id)
    if action == "list_micro_snapshots":
        return list_micro_snapshots()
    if action == "clear_micro_snapshots":
        clear_micro_snapshots()
        return {"status": "OK", "cleared": True}
    if action == "golden":
        return create_golden_snapshot()
    if action == "restore_golden":
        return restore_golden_snapshot()
    if action == "quarantine_status":
        return get_quarantine_status()
    if action == "workspace_snapshot":
        from engine.backup import create_workspace_snapshot
        return create_workspace_snapshot(path=name or ".")
    if action == "workspace_restore":
        from engine.backup import restore_workspace_snapshot
        return restore_workspace_snapshot(path=name or ".")
    fail(f"Acción de backup desconocida: {action}", valid=SCHEMA["backup"]["actions"])


def domain_audit(action: str, name: str | None) -> Any:
    from engine.catalog import ArtifactCatalog
    from engine.security import get_agent_usage_summary, verify_audit_chain

    cat = ArtifactCatalog()
    if action == "verify":
        with cat._get_ro_conn() as conn:
            return verify_audit_chain(conn)
    if action == "usage":
        with cat._get_ro_conn() as conn:
            return get_agent_usage_summary(conn, session_id=name)
    fail(f"Acción de audit desconocida: {action}", valid=SCHEMA["audit"]["actions"])


def domain_ipc(action: str, name: str | None) -> Any:
    chmod_tier = _chmod_tier()
    if action in ("lease", "release", "reap", "flush"):
        if chmod_tier == "4r--":
            return {
                "status": "DEGRADED",
                "action": action,
                "chmod_tier": chmod_tier,
                "scope": "auditor",
                "message": f"Mutaciones IPC deshabilitadas en nivel {chmod_tier} (auditor).",
            }

    from engine.ipc_pool import (
        GLOBAL_SESSION_POOL,
        GLOBAL_SOCKET_MUX,
        ensure_ipc_server_started,
        ipc_client_request,
    )

    if action == "status":
        pool_status = GLOBAL_SESSION_POOL.status()
        mux_status = GLOBAL_SOCKET_MUX.status()
        return {
            "status": "OK",
            "ipc_socket": str(GLOBAL_SOCKET_MUX.socket_path),
            "socket_active": GLOBAL_SOCKET_MUX.is_running,
            "session_pool": pool_status,
            "mux": mux_status,
        }
    if action == "ping":
        ensure_ipc_server_started()
        return ipc_client_request({"action": "ping"})
    if action == "lease":
        sid = name.strip() if name and name.strip() else "ctl-default"
        slot = GLOBAL_SESSION_POOL.acquire(session_id=sid, agent_id="aep-ctl")
        return {"status": "OK", "leased_slot": slot}
    if action == "release":
        sid = name.strip() if name and name.strip() else "ctl-default"
        res = GLOBAL_SESSION_POOL.release(session_id=sid, agent_id="aep-ctl", clear_state=False)
        return {"status": "OK", "released": res}
    if action == "reap":
        reaped = GLOBAL_SESSION_POOL.reap_expired()
        return {"status": "OK", "reaped_count": reaped}
    if action == "pool":
        return {"status": "OK", "pool": GLOBAL_SESSION_POOL.status()}
    if action == "flush":
        flushed = GLOBAL_SESSION_POOL.flush()
        return {"status": "OK", "flushed_count": flushed}
    if action == "metrics":
        p_st = GLOBAL_SESSION_POOL.status()
        m_st = GLOBAL_SOCKET_MUX.status()
        return {
            "status": "OK",
            "active_sessions": p_st["active_count"],
            "idle_slots": p_st["idle_count"],
            "allocated_slots": p_st["allocated_count"],
            "total_requests": m_st.get("total_requests", 0),
            "active_clients": m_st.get("active_clients", 0),
            "socket_path": str(GLOBAL_SOCKET_MUX.socket_path),
        }
    if action == "cache":
        sid = name.strip() if name and name.strip() else "ctl-default"
        return GLOBAL_SESSION_POOL.cache_get(session_id=sid, agent_id="aep-ctl")
    fail(f"Acción de ipc desconocida: {action}", valid=SCHEMA["ipc"]["actions"])


def domain_hardware(action: str, name: str | None, *rest: Any) -> Any:
    from engine.hardware import admit_accelerator, probe_accelerators, probe_hardware_inventory

    if action == "inventory":
        return probe_hardware_inventory()
    if action == "accelerators":
        accels = probe_accelerators()
        return {"status": "OK", "count": len(accels), "accelerators": accels}
    if action == "admit":
        raw_tokens = ([name] if name else []) + list(rest)
        device: str | None = None
        req_vram: int = 0
        req_gtt: int = 0
        req_mib: int = 0
        margin: int = 4096

        positional: list[str] = []
        i = 0
        while i < len(raw_tokens):
            token = str(raw_tokens[i])
            if token in ("--vram", "-vram", "--req_vram", "--req-vram") and i + 1 < len(raw_tokens):
                req_vram = int(raw_tokens[i + 1]) if str(raw_tokens[i + 1]).isdigit() else 0
                i += 2
            elif token in ("--gtt", "-gtt", "--req_gtt", "--req-gtt") and i + 1 < len(raw_tokens):
                req_gtt = int(raw_tokens[i + 1]) if str(raw_tokens[i + 1]).isdigit() else 0
                i += 2
            elif token in ("--margin", "-margin", "--margin_mib", "--margin-mib") and i + 1 < len(raw_tokens):
                margin = int(raw_tokens[i + 1]) if str(raw_tokens[i + 1]).isdigit() else 4096
                i += 2
            elif token in ("--req", "-req", "--req_mib", "--req-mib") and i + 1 < len(raw_tokens):
                req_mib = int(raw_tokens[i + 1]) if str(raw_tokens[i + 1]).isdigit() else 0
                i += 2
            elif token in ("--device", "-device", "--card", "-card") and i + 1 < len(raw_tokens):
                device = str(raw_tokens[i + 1])
                i += 2
            else:
                positional.append(token)
                i += 1

        if positional:
            first = positional[0]
            if first.isdigit():
                if req_mib == 0 and req_vram == 0:
                    req_mib = int(first)
            elif first != "auto":
                if not device:
                    device = first

            nums = [int(p) for p in positional[1:] if p.isdigit()]
            if not first.isdigit() and nums:
                if len(nums) == 1 and req_mib == 0 and req_vram == 0 and req_gtt == 0:
                    req_mib = nums[0]
                else:
                    if len(nums) > 0 and req_vram == 0:
                        req_vram = nums[0]
                    if len(nums) > 1 and req_gtt == 0:
                        req_gtt = nums[1]
                    if len(nums) > 2 and margin == 4096:
                        margin = nums[2]
            elif first.isdigit() and nums:
                if len(nums) > 0 and req_gtt == 0:
                    req_gtt = nums[0]
                if len(nums) > 1 and margin == 4096:
                    margin = nums[1]

        return admit_accelerator(
            device=device,
            req_vram_mib=req_vram,
            req_gtt_mib=req_gtt,
            margin_mib=margin,
            req_mib=req_mib,
        )
    fail(f"Acción de hardware desconocida: {action}", valid=SCHEMA["hardware"]["actions"])


DOMAINS = {
    "service": domain_service,
    "network": lambda a, n, *rest: domain_network(a, n, rest[0] if rest else None),
    "storage": lambda a, n: domain_storage(a),
    "package": domain_package,
    "backup": domain_backup,
    "security": domain_security,
    "audit": domain_audit,
    "ipc": domain_ipc,
    "hardware": domain_hardware,
}


def evolve_command(args: list[str]) -> Any:
    """Decision HUMANA (DK-3): `evolve resolve-revert <ciclo> --confirm`. No existe como tool MCP a proposito."""
    if len(args) < 3 or args[1] != "resolve-revert":
        fail("Uso: aep-ctl evolve resolve-revert <ciclo> --confirm", valid=["resolve-revert"])
    cycle = args[2]
    if "--confirm" not in args[3:]:
        fail("resolve-revert exige --confirm (decision humana: libera el push bloqueado por dev_dirty_by_revert)", cycle=cycle)
    from engine import threads as th
    from engine import threads_ledger as tl

    ledger = tl.EvolveLedger(th.default_db_path())
    if not ledger.resolve_revert(cycle):
        fail("El ciclo no esta en estado REVERTED", cycle=cycle)
    return {"status": "OK", "cycle": cycle, "state": "REVERT_RESOLVED", "revert_pending": ledger.revert_pending()}


def main(argv: list[str]) -> None:
    args = [a for a in argv if a != "--json"]  # --json es el default; lo aceptamos y lo ignoramos
    if not args or args[0] in ("schema", "--schema"):
        emit({
            "status": "OK",
            "tool": "aep-ctl",
            "chmod_tier": _chmod_tier(),
            "degradation_matrix": CHMOD_DEGRADATION_MATRIX.get("domains", {}),
            "domains": SCHEMA,
        })
    domain = args[0]
    if domain == "evolve":
        emit(evolve_command(args))
    if domain not in DOMAINS:
        fail(f"Dominio desconocido: {domain}", valid=list(SCHEMA.keys()))
    action = args[1] if len(args) > 1 else None
    if action in ("--schema", "schema"):
        emit({
            "status": "OK",
            "tool": "aep-ctl",
            "domain": domain,
            "chmod_tier": _chmod_tier(),
            "degradation_matrix": CHMOD_DEGRADATION_MATRIX.get("domains", {}).get(domain, {}),
            "schema": SCHEMA[domain],
        })  # ONT-47 T8: no full `domains` dump for a per-domain schema query
    name = args[2] if len(args) > 2 else None
    rest = args[3:] if len(args) > 3 else []
    if not action or action not in SCHEMA[domain]["actions"]:
        fail(f"Acción inválida para {domain}: {action}", valid=SCHEMA[domain]["actions"])
    emit(DOMAINS[domain](action, name, *rest))


if __name__ == "__main__":
    main(sys.argv[1:])
