{
  "_meta": {
    "role": "starter_scaffolding",
    "description": "Plantillas Go estáticas de andamiaje para síntesis y compilación dinámica de artefactos (artifact_lint_and_build). Para introspección e inspección directa en tiempo de ejecución sin compilación, utilice la herramienta built-in default_primitives.",
    "canonical_runtime_tool": "default_primitives",
    "synthesis_tools": [
      "artifact_catalog",
      "artifact_lint_and_build",
      "artifact_execute_in_ram"
    ]
  },
  "templates": [
    {
      "name": "socket-monitor",
      "source": "tpl_socket_monitor.go",
      "category": "network",
      "capability": "system_inspect",
      "tags": [
        "sockets",
        "tcp",
        "udp",
        "ports",
        "listen",
        "listening",
        "netstat",
        "connections",
        "network"
      ],
      "description": "Lista sockets TCP/UDP del host (LISTEN y ESTABLISHED) leyendo el kernel sin invocar netstat; salida JSON tipada.",
      "params": [
        {
          "name": "state",
          "type": "string",
          "required": false,
          "default": ""
        }
      ],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "fd-rescuer",
      "source": "tpl_fd_rescuer.go",
      "category": "process",
      "capability": "process_introspection",
      "tags": [
        "file",
        "descriptors",
        "fd",
        "proc",
        "process",
        "hung",
        "stuck",
        "deadlock",
        "handles",
        "leak"
      ],
      "description": "Inspecciona /proc/PID/fd de un proceso para diagnosticar hilos colgados, deadlocks o fugas de descriptores.",
      "params": [
        {
          "name": "pid",
          "type": "int",
          "required": false,
          "default": 0
        }
      ],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "disk-usage",
      "source": "tpl_disk_usage.go",
      "category": "filesystem",
      "capability": "system_inspect",
      "tags": [
        "disk",
        "storage",
        "statfs",
        "free",
        "used",
        "space",
        "filesystem",
        "capacity",
        "mount"
      ],
      "description": "Uso de disco del sistema de archivos root vía statfs: total, libre y usado en bytes.",
      "params": [
        {
          "name": "path",
          "type": "string",
          "required": false,
          "default": "/"
        }
      ],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "mem-stat",
      "source": "tpl_mem_stat.go",
      "category": "memory",
      "capability": "system_inspect",
      "tags": [
        "memory",
        "ram",
        "meminfo",
        "free",
        "available",
        "total",
        "swap",
        "oom",
        "usage",
        "used",
        "consumption"
      ],
      "description": "Uso de memoria: lee /proc/meminfo y reporta RAM total, libre y disponible (usage) en bytes.",
      "params": [],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "landlock-guard",
      "source": "tpl_landlock_guard.go",
      "category": "security",
      "capability": "security_sandbox",
      "tags": [
        "landlock",
        "sandbox",
        "lsm",
        "security",
        "isolation",
        "kernel",
        "filesystem",
        "probe"
      ],
      "description": "Sonda estática en Go para auditar soporte y confinamiento de Landlock LSM (Kernel 5.13+) vía syscalls puras.",
      "params": [],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    }
  ]
}
