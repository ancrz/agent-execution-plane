{
  "_meta": {
    "role": "starter_scaffolding",
    "description": "Static Go scaffolding templates for dynamic artifact synthesis and compilation (artifact_lint_and_build). For direct runtime introspection without compilation, use the built-in default_primitives tool.",
    "canonical_runtime_tool": "default_primitives",
    "synthesis_tools": [
      "artifact_catalog",
      "artifact_lint_and_build",
      "artifact_execute_in_ram"
    ]
  },
  "templates": [
    {
      "name": "socket-monitor",
      "source": "tpl_socket_monitor.go",
      "category": "network",
      "capability": "system_inspect",
      "tags": [
        "sockets",
        "tcp",
        "udp",
        "ports",
        "listen",
        "listening",
        "netstat",
        "connections",
        "network"
      ],
      "description": "Lists host TCP/UDP sockets (LISTEN and ESTABLISHED) by reading the kernel directly without netstat; typed JSON output.",
      "params": [
        {
          "name": "state",
          "type": "string",
          "required": false,
          "default": ""
        }
      ],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "fd-rescuer",
      "source": "tpl_fd_rescuer.go",
      "category": "process",
      "capability": "process_introspection",
      "tags": [
        "file",
        "descriptors",
        "fd",
        "proc",
        "process",
        "hung",
        "stuck",
        "deadlock",
        "handles",
        "leak"
      ],
      "description": "Inspects /proc/PID/fd of a process to diagnose hung threads, deadlocks or descriptor leaks.",
      "params": [
        {
          "name": "pid",
          "type": "int",
          "required": false,
          "default": 0
        }
      ],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "disk-usage",
      "source": "tpl_disk_usage.go",
      "category": "filesystem",
      "capability": "system_inspect",
      "tags": [
        "disk",
        "storage",
        "statfs",
        "free",
        "used",
        "space",
        "filesystem",
        "capacity",
        "mount"
      ],
      "description": "Root filesystem disk usage via statfs: total, free and used bytes.",
      "params": [
        {
          "name": "path",
          "type": "string",
          "required": false,
          "default": "/"
        }
      ],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "mem-stat",
      "source": "tpl_mem_stat.go",
      "category": "memory",
      "capability": "system_inspect",
      "tags": [
        "memory",
        "ram",
        "meminfo",
        "free",
        "available",
        "total",
        "swap",
        "oom",
        "usage",
        "used",
        "consumption"
      ],
      "description": "Memory usage: reads /proc/meminfo and reports total, free and available RAM (usage) in bytes.",
      "params": [],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    },
    {
      "name": "landlock-guard",
      "source": "tpl_landlock_guard.go",
      "category": "security",
      "capability": "security_sandbox",
      "tags": [
        "landlock",
        "sandbox",
        "lsm",
        "security",
        "isolation",
        "kernel",
        "filesystem",
        "probe"
      ],
      "description": "Static Go probe to audit Landlock LSM support and confinement (Kernel 5.13+) via pure syscalls.",
      "params": [],
      "scaffolding_only": true,
      "runtime_alternative": "default_primitives"
    }
  ]
}
